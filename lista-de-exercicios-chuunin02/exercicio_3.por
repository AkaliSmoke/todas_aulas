programa
{
    funcao inicio()
    {
        inteiro meses, totalDias

        escreva("Digite a quantidade de meses: ")
        leia(meses)

        // Cada mês tem 30 dias
        totalDias = meses * 30

        escreva("Você informou ", meses, " meses, o que equivale a ", totalDias, " dias.\n")
    }
}

