programa
{
	
	funcao inicio()
	{
		inteiro valor_1 = 0, valor_2 = 0, valor_3 = 0
		real resultado = 0
		escreva("Informe o primeiro valor: ")
		leia(valor_1)
		escreva("Informe o segundo valor: ")
		leia(valor_2)
		escreva("Informe o terceiro valor: ")
		leia(valor_3)

		resultado = (valor_1 + valor_2 + valor_3) / 3
		escreva (resultado)
	}
}
