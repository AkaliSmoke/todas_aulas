programa
{
    funcao inicio()
    {
        inteiro contador

        // Inicializa o contador para começar a contagem em 1.
        contador = 1
        
        // A repetição continua enquanto a condição for verdadeira, até 100.
        enquanto(contador <= 100) {
            // Exibe o valor atual do contador na tela.
            escreva(contador)
            escreva("\n")
            
            // Incrementa o contador para a próxima iteração.
            contador = contador + 1
        }
    }
}
