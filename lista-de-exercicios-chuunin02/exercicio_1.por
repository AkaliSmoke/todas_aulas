programa
{
	
	funcao inicio()
	{
		real estoque_medio = 0.0, quantidade_minima = 1.0, quantidade_maxima = 10.0
		estoque_medio = (quantidade_minima + quantidade_maxima) / 2
		escreva( "Estoque médio é: " + estoque_medio  )
	}
}
