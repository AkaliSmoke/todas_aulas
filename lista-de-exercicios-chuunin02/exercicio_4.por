programa
{
  funcao inicio()
    {
    inteiro val1, val2, val3, val4, val5
    real media

    escreva("digite o valor 1: ")
    leia(val1)
    escreva("digite o valor 2: ")
    leia(val2)
    escreva("digite o valor 3: ")
    leia(val3)
    escreva("digite o valor 4: ")
    leia(val4)
    escreva("digite o valor 5: ")
    leia(val5)

    media = (val1 + val2 + val3 + val4 + val5) / 5
    escreva("Valor médio é: " + media)
    }
}
